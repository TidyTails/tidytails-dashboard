{
  "name": "remotion-videos",
  "version": "1.0.0",
  "description": "TJ's Video Content Generator",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "render:all": "npm run render:tidy1 && npm run render:tidy2 && npm run render:shed1 && npm run render:shed2 && npm run render:consult1 && npm run render:consult2",
    "render:tidy1": "remotion render src/index.ts TidyTailsTransformation out/tidy-tails-transformation.mp4",
    "render:tidy2": "remotion render src/index.ts TidyTailsBrand out/tidy-tails-brand.mp4",
    "render:shed1": "remotion render src/index.ts ShedMath out/shed-math.mp4",
    "render:shed2": "remotion render src/index.ts ShedSpring out/shed-spring.mp4",
    "render:consult1": "remotion render src/index.ts ConsultingProblem out/consulting-problem.mp4",
    "render:consult2": "remotion render src/index.ts ConsultingPackages out/consulting-packages.mp4"
  },
  "keywords": [],
  "author": "Franklin",
  "license": "ISC",
  "dependencies": {
    "@remotion/bundler": "^4.0.424",
    "@remotion/cli": "^4.0.424",
    "@remotion/renderer": "^4.0.424",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.424",
    "typescript": "^5.9.3"
  }
}
